<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_transparent_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top: Thứ & Ngày Tháng Dương Lịch -->
    <TextView
        android:id="@+id/tv_widget_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:shadowColor="#D0000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Thứ Ba, 17/11/2026"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Center: 2 Cột Dương Lịch & Âm Lịch Hiện Hành -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Cột Dương Lịch -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_solar_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:shadowColor="#E0000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:text="17"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_solar_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#D0000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Dương lịch"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cột Âm Lịch -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_lunar_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:shadowColor="#E0000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:text="9"
                android:textColor="#FBBF24"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_lunar_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#D0000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Tháng 10 ÂL"
                android:textColor="#FEF08A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom: Can Chi Năm / Ngày -->
    <TextView
        android:id="@+id/tv_widget_can_chi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:shadowColor="#D0000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Ất Mùi • Bính Ngọ"
        android:textColor="#CBD5E1"
        android:textSize="11sp" />

</LinearLayout>
